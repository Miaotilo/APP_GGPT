/** pages/process/process.wxss - 合作流程页样式 */

/* ===== 标题区域 ===== */
.process-header {
  padding-top: 20rpx;
}

/* ===== 时间轴 ===== */
.timeline {
  padding: 8rpx 32rpx 24rpx;
}

.timeline-item {
  display: flex;
  gap: 28rpx;
  margin-bottom: 0;
}

/* 左侧 */
.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 60rpx;
  flex-shrink: 0;
}

.timeline-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #262626;
  border: 2rpx solid rgba(185, 148, 72, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #B99448;
  flex-shrink: 0;
}

.timeline-dot.dot-active {
  background: #B99448;
  color: #111111;
  border-color: #B99448;
  box-shadow: 0 0 16rpx rgba(185, 148, 72, 0.3);
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  min-height: 40rpx;
  background: linear-gradient(to bottom, rgba(185, 148, 72, 0.2), rgba(185, 148, 72, 0.05));
}

.timeline-line.line-last {
  display: none;
}

/* 右侧卡片 */
.timeline-card {
  flex: 1;
  background: #1c1c1c;
  border: 1rpx solid rgba(185, 148, 72, 0.1);
  border-radius: 14rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.timeline-step-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #D4B472;
}

.timeline-desc {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
}

/* ===== 温馨提示 ===== */
.tip-card {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin: 8rpx 32rpx 32rpx;
  padding: 28rpx 24rpx;
  background: rgba(185, 148, 72, 0.06);
  border: 1rpx solid rgba(185, 148, 72, 0.12);
  border-radius: 14rpx;
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #999999;
  line-height: 1.7;
}