/** pages/contact/contact.wxss - 联系我们样式 */

/* ===== 标题区域 ===== */
.contact-header {
  padding-top: 20rpx;
}

/* ===== 联系方式卡片 ===== */
.contact-cards {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.contact-card {
  background: #1c1c1c;
  border: 1rpx solid rgba(185, 148, 72, 0.12);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.contact-card-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(185, 148, 72, 0.1);
  border-radius: 50%;
  margin-bottom: 4rpx;
}

.contact-card-icon {
  font-size: 44rpx;
}

.contact-card-label {
  font-size: 26rpx;
  color: #999999;
}

.contact-card-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #D4B472;
  letter-spacing: 2rpx;
}

/* ===== 操作按钮 ===== */
.contact-action-btn {
  width: 260rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #B99448 0%, #D4B472 50%, #B99448 100%);
  border-radius: 36rpx;
  margin-top: 12rpx;
  box-shadow: 0 6rpx 24rpx rgba(185, 148, 72, 0.25);
}

.contact-action-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.action-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
  letter-spacing: 2rpx;
}

.btn-wechat {
  background: rgba(185, 148, 72, 0.12);
  border: 1rpx solid #B99448;
  box-shadow: none;
}

.btn-wechat .action-btn-text {
  color: #B99448;
}

/* ===== 微信二维码占位区域 ===== */
.qr-placeholder {
  width: 280rpx;
  height: 280rpx;
  background: #262626;
  border: 1rpx solid rgba(185, 148, 72, 0.15);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx 0 4rpx;
  overflow: hidden;
}

.qr-placeholder:active {
  background: #2a2a2a;
}

.qr-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.qr-icon {
  font-size: 64rpx;
  color: #666666;
  line-height: 1;
}

.qr-text {
  font-size: 26rpx;
  color: #B99448;
  font-weight: 500;
}

.qr-sub {
  font-size: 20rpx;
  color: #666666;
}

/* ===== 咨询提示 ===== */
.contact-tip {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin: 0 24rpx 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(185, 148, 72, 0.04);
  border: 1rpx solid rgba(185, 148, 72, 0.1);
  border-radius: 12rpx;
}

.contact-tip:last-of-type {
  margin-bottom: 0;
}

.tip-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.tip-content {
  flex: 1;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}