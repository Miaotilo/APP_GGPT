/** pages/mode/mode.wxss - 共管模式页样式 */

/* ===== 页面标题 ===== */
.mode-header {
  padding: 40rpx 32rpx 10rpx;
  text-align: center;
}

.mode-header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #D4B472;
  display: block;
  margin-bottom: 12rpx;
}

.mode-header-sub {
  font-size: 30rpx;
  color: #EAEAEA;
  display: block;
  line-height: 1.5;
}

/* ===== 对比表格 ===== */
.compare-table {
  margin: 0 24rpx 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(185, 148, 72, 0.15);
}

.compare-row {
  display: flex;
  border-bottom: 1rpx solid rgba(185, 148, 72, 0.06);
}

.compare-row:last-child {
  border-bottom: none;
}

.compare-header {
  background: rgba(185, 148, 72, 0.1);
  font-weight: 700;
}

.compare-cell {
  flex: 1;
  padding: 22rpx 14rpx;
  font-size: 24rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
  color: #999999;
}

.cell-label {
  width: 28%;
  flex: none;
  color: #EAEAEA;
  font-weight: 600;
}

.cell-mode {
  width: 36%;
  flex: none;
  color: #D4B472;
}

.cell-old {
  width: 36%;
  flex: none;
  color: #888888;
}

.compare-header .compare-cell {
  color: #EAEAEA;
  font-size: 26rpx;
}

/* ===== 模式详解卡片 ===== */
.card-list {
  padding: 0 24rpx;
}

.mode-card {
  display: flex;
  gap: 20rpx;
  background: #1c1c1c;
  border: 1rpx solid rgba(185, 148, 72, 0.12);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.mode-card:last-child {
  margin-bottom: 0;
}

.mode-card-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #B99448;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(185, 148, 72, 0.1);
  border-radius: 10rpx;
}

.mode-card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.mode-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #D4B472;
}

.mode-card-desc {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.7;
}

/* ===== FAQ ===== */
.faq-list {
  padding: 0 24rpx;
}

.faq-item {
  background: #1c1c1c;
  border: 1rpx solid rgba(185, 148, 72, 0.1);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.faq-q {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  gap: 16rpx;
}

.faq-q-tag {
  width: 34rpx;
  height: 34rpx;
  background: #B99448;
  color: #111111;
  font-weight: 700;
  font-size: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.faq-q-text {
  flex: 1;
  font-size: 28rpx;
  color: #EAEAEA;
  line-height: 1.4;
}

.faq-arrow {
  font-size: 28rpx;
  color: #B99448;
  transition: transform 0.3s;
  flex-shrink: 0;
}

.faq-arrow.arrow-up {
  transform: rotate(90deg);
}

.faq-a {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease;
}

.faq-a-open {
  max-height: 500rpx;
}

.faq-a-inner {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 28rpx;
}

.faq-a-tag {
  width: 34rpx;
  height: 34rpx;
  background: rgba(185, 148, 72, 0.12);
  color: #B99448;
  font-weight: 700;
  font-size: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.faq-a-text {
  flex: 1;
  font-size: 26rpx;
  color: #999999;
  line-height: 1.7;
}