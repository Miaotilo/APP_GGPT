/** app.wxss - 全局样式 */
/* 黑金轻奢商务风格 · 全局色彩与基础样式 */

/* CSS 变量定义 */
page {
  --color-gold: #B99448;
  --color-gold-light: #D4B472;
  --color-bg: #111111;
  --color-card-bg: #1c1c1c;
  --color-text: #EAEAEA;
  --color-text-secondary: #999999;

  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* 页面容器 — 每个页面最外层使用，底部预留空间给悬浮按钮 */
.page-container {
  min-height: 100vh;
  padding-bottom: 220rpx;
  background-color: var(--color-bg);
}

/* ---- 通用文字类 ---- */
.gold-text {
  color: var(--color-gold) !important;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  text-align: center;
  padding: 40rpx 32rpx 8rpx;
  line-height: 1.4;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  padding: 0 40rpx 16rpx;
  line-height: 1.6;
}

/* 金色装饰分割线 */
.gold-divider {
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--color-gold), var(--color-gold-light));
  margin: 8rpx auto 28rpx;
  border-radius: 2rpx;
}

/* ---- 卡片基础 ---- */
.card {
  background: var(--color-card-bg);
  border-radius: 16rpx;
  border: 1rpx solid rgba(185, 148, 72, 0.12);
  padding: 32rpx 28rpx;
  margin: 0 24rpx 20rpx;
}

/* ---- 表单通用 ---- */
.form-input {
  width: 100%;
  height: 80rpx;
  background: #262626;
  border: 1rpx solid rgba(185, 148, 72, 0.15);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

.form-input.placeholder {
  color: #666666;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #262626;
  border: 1rpx solid rgba(185, 148, 72, 0.15);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}